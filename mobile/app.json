{
  "expo": {
    "name": "Ostinato",
    "slug": "ostinato",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ostinato",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.nspx.ostinato",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "NSCameraUsageDescription": "Para ler o horário das aulas a partir de uma foto, no próprio aparelho.",
        "NSPhotoLibraryUsageDescription": "Para ler o horário das aulas a partir de uma imagem que você já tem.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false,
        "NSMicrophoneUsageDescription": "Para anotar a tarefa falando, em vez de digitar.",
        "NSSpeechRecognitionUsageDescription": "Para transformar o que você fala em tarefa. O reconhecimento roda no próprio aparelho."
      },
      "icon": "./assets/icone.png",
      "appleTeamId": "A44CCRN8Y4"
    },
    "android": {
      "package": "dev.nspx.ostinato",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone.png",
        "backgroundColor": "#14110F"
      }
    },
    "plugins": [
      "./plugins/ios-assinatura",
      "./plugins/textos-de-permissao",
      "./plugins/icloud",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icone.png",
          "imageWidth": 180,
          "backgroundColor": "#14110F",
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1F1B16",
          "sounds": [
            "./assets/ostinato-sino.caf"
          ]
        }
      ],
      "expo-audio",
      "expo-background-task",
      "./plugins/widget"
    ],
    "extra": {
      "icloud": false,
      "widget": true
    },
    "icon": "./assets/icone.png",
    "backgroundColor": "#14110F"
  }
}
