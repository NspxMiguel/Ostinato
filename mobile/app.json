{
  "expo": {
    "name": "Ostinato",
    "slug": "ostinato",
    "version": "2.0",
    "orientation": "portrait",
    "scheme": "ostinato",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ostinato.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "NSAlarmKitUsageDescription": "Para tocar o alarme do iPhone na hora de um compromisso, mesmo com o telefone no silencioso.",
        "NSCameraUsageDescription": "Para ler o horário das aulas a partir de uma foto, no próprio aparelho.",
        "NSPhotoLibraryUsageDescription": "Para ler o horário das aulas a partir de uma imagem que você já tem.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false,
        "NSMicrophoneUsageDescription": "Para anotar a tarefa falando, em vez de digitar.",
        "NSSpeechRecognitionUsageDescription": "Para transformar o que você fala em tarefa. O reconhecimento roda no próprio aparelho."
      },
      "icon": "./assets/icone.png",
      "appleTeamId": "SW36PU2B3T"
    },
    "android": {
      "package": "com.ostinato.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "./plugins/ios-assinatura",
      "./plugins/textos-de-permissao",
      "./plugins/icloud",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icone.png",
          "imageWidth": 180,
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1F1B16",
          "sounds": [
            "./assets/ostinato-sino.caf",
            "./assets/ostinato-marimba.caf",
            "./assets/ostinato-pulso.caf",
            "./assets/ostinato-radar.caf",
            "./assets/ostinato-harpa.caf",
            "./assets/ostinato-sonar.caf",
            "./assets/ostinato-carrilhao.caf",
            "./assets/ostinato-farol.caf"
          ]
        }
      ],
      "expo-audio",
      "expo-background-task",
      "./plugins/grupo",
      "./plugins/widget",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "icloud": false,
      "widget": true,
      "rotuloDeBuild": "C1"
    },
    "icon": "./assets/icone.png",
    "backgroundColor": "#000000"
  }
}
